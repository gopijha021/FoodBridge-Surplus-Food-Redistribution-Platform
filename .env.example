APP_ENV=local
DATABASE_URL=postgresql+psycopg://foodbridge:foodbridge@localhost:5432/foodbridge
USE_POSTGIS=true
REDIS_URL=redis://localhost:6379/0
BROKER_URL=amqp://guest:guest@localhost:5672//
# inline = outbox rows are handled in-process; celery = published to the broker
EVENT_BACKEND=celery
EMBEDDED_WORKER=false
JWT_SECRET=replace_me
ACCESS_TOKEN_TTL_MINUTES=15
DONATION_DEFAULT_RADIUS_KM=10
LOG_LEVEL=INFO
